<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Вибро-подсказка при командах с гарнитуры (видно даже слепому,
         когда TalkBack молчит). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Онлайн-каталоги книг (OPDS): скачиваем ленты и сами книги. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Чтение не должно замирать, когда телефон лежит (msg4211, #19): экран
         гаснет как обычно, а процессор под PARTIAL_WAKE_LOCK работает —
         иначе система уводит устройство в глубокий сон между фразами и
         замирают и синтез, и сторож. Блокировку держим только на время
         чтения (см. KeepAwake). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- «Работа в фоне» (msg4476): разрешение не ограничивать расход батареи —
         оно вынимает приложение из Doze. Тестеры на Poco и realme: с
         заблокированным экраном движок синтеза молчал по 12–15 с, и чтение
         вставало. Спрашиваем ровно один раз, кнопкой в настройках. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Foreground-медиа-сервис: без этого набора прав Android уронит
         сервис на старте (SecurityException на startForeground). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- «После звонка» (#98): конец настоящего звонка → продолжить чтение.
         Просится в рантайме, только когда включён этот режим. Номера не
         читаются и не сохраняются — слушаем только начало/конец звонка. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Автообновление (#35): BookVoice сам ставит скачанный APK поверх текущей
         версии. Android 8+ просит у пользователя разрешение на установку из
         этого источника; сам диалог системы — при первом запуске установщика. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Голосовой поиск в каталоге (msg4755): микрофон слушаем САМИ, без
         системного окна распознавания — оно поднималось ~2 с и владелец терял
         начало фразы. Просится в рантайме при первом нажатии; не дали — поиск
         уходит на прежний системный путь и продолжает работать. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- msg1170/1172: «Доступ ко всем файлам». Нужен для ЖЕЛЕЗНОЙ записи копий
         и скачиваний в любую выбранную папку: MixPlorer и часть других
         проводников отдают SAF-tree, но их provider не умеет createDocument —
         обычная запись туда падает. С этим разрешением пишем реальным путём
         (/storage/…), как сам проводник. Просится один раз на Android 11+,
         когда выбрана такая папка (AllFiles.kt). На Google Play это разрешение
         ограничено, но BookVoice ставится напрямую — ок. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 11+ скрывает от приложения чужие TTS-движки, если явно
         не объявить видимость этого сервиса. Без этого списка движков
         виден только системный (Google). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic=true: часть зеркал OPDS отдают каталог по http,
         а Android 9+ по умолчанию такие запросы режет. Чувствительных данных
         читалка не шлёт, риск принимаем ради совместимости с каталогами. -->
    <!-- BookVoiceApp = глобальный сторож падений: пишет стек краха в diag.log
         перед смертью приложения (см. класс). Прописан здесь, чтобы onCreate
         сработал до первой Activity/Service. -->
    <application
        android:name=".BookVoiceApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookVoice"
        android:usesCleartextTraffic="true">

        <!-- Дом (msg1676+): корневое окно «Библиотека». Нижних вкладок нет —
             Каталог и Настройки открываются отдельными окнами ПОВЕРХ полки из
             меню «⋮». singleTop: возврат из читалки CLEAR_TOP-интентом (и повторные
             запуски с рабочего стола) не плодят новых копий дома. launcher и
             «Открыть с помощью» (msg748) — как у бывшего хоста TabsActivity. -->
        <activity
            android:name=".LibraryWindowActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- msg748/4853: BookVoice в списке «Открыть с помощью» и
                 «Поделиться». Поимённых типов (msg748) оказалось мало: файловые
                 менеджеры отдают .fb2 — а нередко и любой файл — как
                 application/octet-stream или вовсе без типа, и нас в списке не
                 было. Ниже ловим ЛЮБОЙ тип и любые локальные схемы (content://
                 из SAF и своего провайдера, file:// у старых проводников,
                 android.resource://), а отбор по расширению делает само
                 приложение (LibraryActivity.onBookPicked): чужой файл оно не
                 откроет, зато честно скажет, что формат не тот. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="android.resource" />
            </intent-filter>

            <!-- Второй фильтр — на случай интента БЕЗ типа вовсе (часть
                 менеджеров кладёт тип только в extra): фильтр без mimeType тип
                 не ограничивает, поэтому такая ссылка тоже доходит. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>

        <!-- Окна поверх полки (msg1676+): «Каталоги» и «Настройки» из меню «⋮»
             полки, как книга. Своих intent-filter нет — вызываются только
             явным интентом из приложения. -->
        <activity
            android:name=".CatalogWindowActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsWindowActivity"
            android:exported="false" />

        <!-- «О программе» (msg2879-2934): справка из меню «⋮» полки. Своих
             intent-filter нет — вызывается только явным интентом. -->
        <activity
            android:name=".AboutWindowActivity"
            android:exported="false" />

        <!-- «Не засыпать» (msg4705/4709): состояние энергетических запретов и
             дороги к прошивочным экранам (автозапуск MIUI/ColorOS, фоновая
             активность, ограничение у движка речи). Открывается строкой корня
             Настроек; своих intent-filter нет. -->
        <activity
            android:name=".SleepWindowActivity"
            android:exported="false" />

        <!-- Таймер сна (msg4993): выбор времени и «до конца главы» — из меню «⋮»
             книги и по долгому нажатию «▶». Окно поверх читалки; своих
             intent-filter нет. -->
        <activity
            android:name=".SleepTimerWindowActivity"
            android:exported="false" />

        <!-- Настройки таймера (msg4993): жесты, чувствительность, сигнал и
             проверки без ожидания. Открывается строкой из окна таймера. -->
        <activity
            android:name=".SleepTimerSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Цитаты (#104) — из меню «⋮ Ещё» библиотеки. -->
        <activity
            android:name=".QuotesActivity"
            android:exported="false" />

        <!-- Медиа-сессия живёт в сервисе, а не в окне — так система отдаёт
             кнопки гарнитуры и «волшебное касание» нам, а не чужому плееру. -->
        <service
            android:name=".MediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Медиа-кнопки гарнитуры и «волшебное касание» TalkBack приходят
             сюда, receiver передаёт их в активную MediaSessionCompat. -->
        <receiver
            android:name=".MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Доступ к файлу лога для отправки его в Telegram (Настройки → лог). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
