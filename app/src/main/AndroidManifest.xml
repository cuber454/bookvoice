<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Вибро-подсказка при командах с гарнитуры (видно даже слепому,
         когда TalkBack молчит). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Онлайн-каталоги книг (OPDS): скачиваем ленты и сами книги. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Чтение не должно замирать, когда телефон лежит (msg4211, #19): экран
         гаснет как обычно, а процессор под PARTIAL_WAKE_LOCK работает —
         иначе система уводит устройство в глубокий сон между фразами и
         замирают и синтез, и сторож. Блокировку держим только на время
         чтения (см. KeepAwake). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- «Работа в фоне» (msg4476): разрешение не ограничивать расход батареи —
         оно вынимает приложение из Doze. Тестеры на Poco и realme: с
         заблокированным экраном движок синтеза молчал по 12–15 с, и чтение
         вставало. Спрашиваем ровно один раз, кнопкой в настройках. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Foreground-медиа-сервис: без этого набора прав Android уронит
         сервис на старте (SecurityException на startForeground). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- «После звонка» (#98): конец настоящего звонка → продолжить чтение.
         Просится в рантайме, только когда включён этот режим. Номера не
         читаются и не сохраняются — слушаем только начало/конец звонка. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Автообновление (#35): BookVoice сам ставит скачанный APK поверх текущей
         версии. Android 8+ просит у пользователя разрешение на установку из
         этого источника; сам диалог системы — при первом запуске установщика. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Голосовой поиск в каталоге (msg4755): микрофон слушаем САМИ, без
         системного окна распознавания — оно поднималось ~2 с и владелец терял
         начало фразы. Просится в рантайме при первом нажатии; не дали — поиск
         уходит на прежний системный путь и продолжает работать. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- msg1170/1172: «Доступ ко всем файлам». Нужен для ЖЕЛЕЗНОЙ записи копий
         и скачиваний в любую выбранную папку: MixPlorer и часть других
         проводников отдают SAF-tree, но их provider не умеет createDocument —
         обычная запись туда падает. С этим разрешением пишем реальным путём
         (/storage/…), как сам проводник. Просится один раз на Android 11+,
         когда выбрана такая папка (AllFiles.kt). На Google Play это разрешение
         ограничено, но BookVoice ставится напрямую — ок. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 11+ скрывает от приложения чужие TTS-движки, если явно
         не объявить видимость этого сервиса. Без этого списка движков
         виден только системный (Google). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic=true: часть зеркал OPDS отдают каталог по http,
         а Android 9+ по умолчанию такие запросы режет. Чувствительных данных
         читалка не шлёт, риск принимаем ради совместимости с каталогами. -->
    <!-- BookVoiceApp = глобальный сторож падений: пишет стек краха в diag.log
         перед смертью приложения (см. класс). Прописан здесь, чтобы onCreate
         сработал до первой Activity/Service. -->
    <application
        android:name=".BookVoiceApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookVoice"
        android:usesCleartextTraffic="true">

        <!-- Дом (msg1676+): корневое окно «Библиотека». Нижних вкладок нет —
             Каталог и Настройки открываются отдельными окнами ПОВЕРХ полки из
             меню «⋮». singleTop: возврат из читалки CLEAR_TOP-интентом (и повторные
             запуски с рабочего стола) не плодят новых копий дома. launcher и
             «Открыть с помощью» (msg748) — как у бывшего хоста TabsActivity. -->
        <activity
            android:name=".LibraryWindowActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- msg748/4853/5013: BookVoice в списке «Открыть с помощью»
                 и «Поделиться».

                 Сначала (msg748) типы были поимённые, но их оказалось мало:
                 менеджеры отдают .fb2 — а нередко и любой файл — как
                 application/octet-stream или вовсе без типа, и нас в списке не
                 было. Тогда (msg4853) мы объявили ЛЮБОЙ тип — и тут же
                 всплыла обратная сторона (msg5013): читалка предлагала себя
                 для фотографий, музыки и всего подряд.

                 Почему поимённый список ничего не теряет. Система сравнивает
                 типы так: знающий своё дело менеджер просит конкретный тип
                 (например image/jpeg) — и такой запрос ловит только фильтр с
                 этим типом. А менеджер, который типа не знает, просит «*/*» —
                 и вот такой запрос совпадает с ЛЮБЫМ фильтром, хоть с самым
                 узким. Значит, объявив свои типы, мы по-прежнему получаем и
                 «неизвестные» книги, но перестаём получать картинки, музыку,
                 видео и чужие документы с известным типом.

                 Ловим только те типы, которые читаем (BookParser): epub, fb2,
                 pdf, txt, xml, zip (в нём epub), docx, odt, html, плюс
                 octet-stream — под него попадают книги от нерадивых
                 проводников, и плюс application/xml (fb2 нередко отдают им).
                 Схемы — локальные: content:// из SAF и
                 своего провайдера, file:// у старых проводников,
                 android.resource://. Отбор по расширению по-прежнему делает
                 само приложение (LibraryActivity.onBookPicked): файл не-книги
                 оно не откроет, зато честно скажет, что формат не тот.

                 Доступа это не отнимает: книгу всегда можно открыть из самой
                 читалки — «⋮» → «Открыть файл». -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <!-- msg5835: FB2 — единственный читаемый формат, у которого нет
                     типа, известного самому Android. Поэтому каждый проводник
                     метит его по-своему, и узкий список msg5013 снова спрятал
                     нас от MiXplorer: pdf он в списке показывал, fb2 — нет
                     (тот же баг, что закрывали в msg4853 широким фильтром).
                     Ниже — ходовые ярлыки FB2 и сжатого fb2.zip. Картинок и
                     музыки они не возвращают: их типы по-прежнему не наши. -->
                <data android:mimeType="application/fb2" />
                <data android:mimeType="application/fb2+xml" />
                <data android:mimeType="application/fb2+zip" />
                <data android:mimeType="application/x-fb2" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/fictionbook2+zip" />
                <data android:mimeType="application/fictionbook3+zip" />
                <data android:mimeType="text/fb2" />
                <data android:mimeType="text/fb2+xml" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/zip" />
                <!-- Сжатый fb2.zip: часть проводников метит его не «application/zip»,
                     а этим типом — книга внутри читается так же. -->
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="android.resource" />
            </intent-filter>

            <!-- Второй фильтр — на случай интента БЕЗ типа вовсе (часть
                 менеджеров кладёт тип только в extra): фильтр, не объявивший
                 ни одного типа, с типизированным интентом не совпадает, зато
                 ловит интенты без типа. Это единственный оставшийся «широкий»
                 вход, и он остаётся нарочно (msg5013): без него книга от
                 менеджера, который тип не проставил, не открылась бы вовсе. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>

        <!-- Окна поверх полки (msg1676+): «Каталоги» и «Настройки» из меню «⋮»
             полки, как книга. Своих intent-filter нет — вызываются только
             явным интентом из приложения. -->
        <activity
            android:name=".CatalogWindowActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsWindowActivity"
            android:exported="false" />

        <!-- «О программе» (msg2879-2934): справка из меню «⋮» полки. Своих
             intent-filter нет — вызывается только явным интентом. -->
        <activity
            android:name=".AboutWindowActivity"
            android:exported="false" />

        <!-- «Не засыпать» (msg4705/4709): состояние энергетических запретов и
             дороги к прошивочным экранам (автозапуск MIUI/ColorOS, фоновая
             активность, ограничение у движка речи). Открывается строкой корня
             Настроек; своих intent-filter нет. -->
        <activity
            android:name=".SleepWindowActivity"
            android:exported="false" />

        <!-- Таймер сна (msg4993): выбор времени и «до конца главы» — из меню «⋮»
             книги и по долгому нажатию «▶». Окно поверх читалки; своих
             intent-filter нет. -->
        <activity
            android:name=".SleepTimerWindowActivity"
            android:exported="false" />

        <!-- Настройки таймера (msg4993): жесты, чувствительность, сигнал и
             проверки без ожидания. Открывается строкой из окна таймера. -->
        <activity
            android:name=".SleepTimerSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Цитаты (#104) — из меню «⋮ Ещё» библиотеки. -->
        <activity
            android:name=".QuotesActivity"
            android:exported="false" />

        <!-- Возврат из браузера после входа в Яндекс (msg6114). Адрес
             bookvoice://oauth открывает система — это единственный intent-filter
             приложения, ведущий снаружи внутрь. Своего экрана у окна нет (тема
             полупрозрачная): меняет код на токен в фоне и закрывается, владелец
             возвращается в Настройки. -->
        <activity
            android:name=".YandexAuthActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bookvoice" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Медиа-сессия живёт в сервисе, а не в окне — так система отдаёт
             кнопки гарнитуры и «волшебное касание» нам, а не чужому плееру. -->
        <service
            android:name=".MediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Медиа-кнопки гарнитуры и «волшебное касание» TalkBack приходят
             сюда, receiver передаёт их в активную MediaSessionCompat. -->
        <receiver
            android:name=".MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Доступ к файлу лога для отправки его в Telegram (Настройки → лог). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
