<?xml version="1.0" encoding="utf-8"?>
<!-- Линия-разделитель ПОД строкой списка (msg4173, отзыв стороннего пользователя:
     «хотелось бы, чтобы название каждой книги было визуально отделено от другой»).
     Рисуем рамку на всю строку и отрицательными отступами сдвигаем её верх, лево и
     право за пределы строки — остаётся видимой только нижняя линия.

     Цвет светлее обычных линий приложения (#3C4043, ими нарисованы полоска под
     вкладками и рамка карточки): на фоне #101418 они дают контраст ~1.8:1 и
     слабовидящему глазу почти не видны, а #6E7478 — ~3.9:1, то есть выше порога
     3:1, который WCAG требует для нетекстовых элементов интерфейса. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#6E7478" />
        </shape>
    </item>
</layer-list>
