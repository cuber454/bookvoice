<?xml version="1.0" encoding="utf-8"?>
<!-- Текстовая карточка книги в режиме «сетка» (msg649): обложек не извлекаем,
     поэтому карточка — это заливка со скруглением вокруг названия и автора.
     Цвета согласованы с тёмной темой библиотеки (#101418 фон, #3C4043 линии). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E2227" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#3C4043" />
</shape>
