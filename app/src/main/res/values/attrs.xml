<?xml version="1.0" encoding="utf-8"?>
<!--
  Цвета интерфейса как атрибуты темы (msg5730).

  Зачем атрибуты, а не просто цвета. «Высокая контрастность» должна менять одни
  и те же места — фон, основной текст, приглушённый текст, акцент — и в разметке,
  и в строках, которые строятся кодом. Атрибут темы это ровно и даёт: обычная
  тема и контрастная отличаются ТОЛЬКО значениями (themes.xml), а разметка и код
  спрашивают цвет у темы и о второй теме не знают. Иначе контраст пришлось бы
  разводить вторым набором экранов.

  Цвета, заданные прямо в разметке (#E8EAED и прочие), атрибут не переживают —
  поэтому перед вводом контраста все литералы переведены на эти имена.
-->
<resources>
    <!-- Фон окна и панелей. -->
    <attr name="bvBg" format="color" />
    <attr name="bvPanel" format="color" />
    <!-- Текст: основной и приглушённый (подсказки, пояснения, вторая строка). -->
    <attr name="bvInk" format="color" />
    <attr name="bvDim" format="color" />
    <!-- Акцент: заголовки глав, ссылки, активная вкладка, выбранный пункт. -->
    <attr name="bvAccent" format="color" />
    <!-- Полоса ползунка перемотки (её непройденная часть). -->
    <attr name="bvTrack" format="color" />
    <!-- Ошибка и предупреждение. -->
    <attr name="bvDanger" format="color" />
    <!-- Подсветка предложений в книге: текущее, опорное (от которого выделяют)
         и попавшие в выделение. -->
    <attr name="bvSelCurrent" format="color" />
    <attr name="bvSelAnchor" format="color" />
    <attr name="bvSelRange" format="color" />
</resources>
