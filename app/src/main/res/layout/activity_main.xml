<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Шапка читалки (msg2090): название книги — заголовком окна, а справа в том
         же ряду кнопка ⋮ «Ещё» — как в окнах Библиотеки/Каталога/Настроек (там ⋮
         в правом верхнем углу шапки). Раньше в читалке ⋮ жила во втором ряду,
         вместе с оглавлением/поиском/закладкой. Название книги читается полностью
         скринридером при входе (window title = книга, см. restoreSession). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:focusable="true"
            android:screenReaderFocusable="true"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:text="@string/no_book"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="#E8EAED" />

        <!-- #101: «⋮ Ещё» — действия читалки (Библиотека, Настройки, Вернуться на
             место, Цитаты, Голос чтения, Выход). В правом верхнем углу, как в
             других окнах. Входит в конструктор экрана: выключена — кнопки нет. -->
        <Button
            android:id="@+id/btnMore"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/reader_more_cd"
            android:gravity="center"
            android:minWidth="48dp"
            app:icon="@drawable/ic_more"
            app:iconSize="24dp" />
    </LinearLayout>

    <!-- msg1296/1299: кнопки верхнего ряда — ТОЛЬКО иконки (без текстовых подписей),
         чтобы не красть место у названия. Иконки не растут с системным шрифтом;
         подписи для скринридера живут в contentDescription у каждой кнопки.
         msg1324: ряд кнопок — своим рядом под шапкой, прижат вправо. ⋮ ушла в
         шапку (msg2090), здесь остаются Оглавление/Поиск/Закладка. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToc"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/toc_btn"
            android:gravity="center"
            android:minWidth="48dp"
            app:icon="@drawable/ic_toc"
            app:iconSize="24dp" />

        <Button
            android:id="@+id/btnSearch"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/search_button_cd"
            android:gravity="center"
            android:minWidth="48dp"
            app:icon="@drawable/ic_search"
            app:iconSize="24dp" />

        <Button
            android:id="@+id/btnBookmark"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/bookmark_btn"
            android:gravity="center"
            android:minWidth="48dp"
            app:icon="@drawable/ic_bookmark"
            app:iconSize="24dp" />
    </LinearLayout>

    <!-- Панель поиска по книге: показывается над списком, текст не перекрывает.
         Поле с кнопкой голосового ввода, счётчик совпадений, Назад/Далее/Закрыть. -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/search_field_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#E8EAED"
                android:textColorHint="#9AA0A6"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSearchMic"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/search_mic_cd"
                android:minWidth="48dp"
                android:text="🎤"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnSearchGo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:text="@string/search_find_btn"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSearchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="#9AA0A6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSearchPrev"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/search_prev_btn"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSearchNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/search_next_btn"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSearchClose"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/search_close_btn"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Средняя зона читалки: шторка голоса и список предложений живут в одном
         контейнере с весом. Когда шторка открывается, она ужимает только список
         ВНУТРИ своей зоны и никогда не выталкивает нижние ряды (позицию, слайдер,
         главный ряд «Пред./Читать/След./Голос») за нижний край экрана (msg2627). -->
    <LinearLayout
        android:id="@+id/voiceArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Шторка «Голос чтения» (msg2403/2415): настройки голоса в верхней части
             экрана — НЕ поверх нижних кнопок. Нижний ряд «◀ Читать ▶» остаётся
             доступным: запустил чтение и крутишь скорость/тон/громкость — слышно
             сразу, на лету. Скрыта по умолчанию; открывает btnVoice в нижнем ряду и
             пункт «Голос чтения» в ⋮-меню. Высоту шторки ограничивает код
             (toggleVoicePanel) высотой этой зоны, чтобы не вытеснить нижний ряд. -->
        <LinearLayout
            android:id="@+id/voicePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A232B"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVoiceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:focusable="true"
                android:screenReaderFocusable="true"
                android:maxLines="1"
                android:text="@string/voice_settings"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="#E8EAED" />

            <Button
                android:id="@+id/btnVoiceClose"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:minWidth="44dp"
                android:text="@string/dialog_close"
                android:textSize="14sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/voiceScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/voiceBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sentenceList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="#9AA0A6" />

    <!-- msg2431: зону перемотки сделали выше (мин. 48dp), чтобы палец при
         перемотке не соскальзывал на кнопки «Медленнее/Быстрее» под слайдером.
         Полоса рисуется по центру выросшей зоны, касание ловит вся зона. -->
    <SeekBar
        android:id="@+id/seekProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/seek_progress"
        android:minHeight="48dp"
        android:max="0"
        android:progress="0" />

    <!-- Ряд кнопок скорости (#58): прячется/возвращается конструктором экрана. -->
    <LinearLayout
        android:id="@+id/speedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSpeedDown"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/speed_down"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="90dp"
            android:text="@string/speed_default"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="#E8EAED" />

        <Button
            android:id="@+id/btnSpeedUp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/speed_up"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- msg2431: кнопки глав короткие, со стрелками. Полные имена («Предыдущая
         глава»/«Следующая глава») скринридеру даёт contentDescription — раньше их
         читал длинный текст самой кнопки. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrevChapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/prev_chapter"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="◀ Глава"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnNextChapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/next_chapter"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Глава ▶"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="#9AA0A6" />

    <!-- msg2375: кнопка «Отметить дочитанной» (btnStatus) убрана с экрана —
         действие переехало в ⋮-меню читалки (showMoreDialog), галочка в
         Конструкторе экрана удалена.
         msg2399: чтобы низ экрана не пустовал, главный ряд управления чтением
         (◀ Пред / Читать / След ▶) перенесён в самый низ — как нижняя панель в
         других окнах. Выше остаются позиция, слайдер, скорость, главы,
         «Прочитано, осталось». msg2415: кнопка «Голос чтения» (btnVoice)
         вернулась четвёртой справа в этот нижний ряд — открывает шторку
         voicePanel наверху, нижний ряд остаётся доступным. msg2431: подписи
         ряда короткие и всегда в одну строку, без стрелок: «Пред.» / «Читать» /
         «След.» / «Голос» — чтобы текст не переносился. Полные имена для
         скринридера живут в contentDescription («Предыдущее предложение»,
         «Следующее предложение», «Голос чтения»). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btnPrevSentence"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/prev_sentence"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Пред."
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Читать"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnNextSentence"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/next_sentence"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="След."
            android:textSize="16sp" />

        <!-- msg2415: кнопка «Голос чтения» — четвёртая в нижнем ряду, справа от
             «След. ▶». Открывает шторку voicePanel наверху (скорость/тон/громкость,
             выбор голоса), нижний ряд остаётся доступным — можно слушать новую
             скорость чтения на лету. Подпись короткая «Голос», скринридеру —
             полное имя через contentDescription. -->
        <Button
            android:id="@+id/btnVoice"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/voice_settings"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Голос"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
