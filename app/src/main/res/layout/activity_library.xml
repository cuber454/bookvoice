<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bvBg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Шапка окна-дома (msg1690 + msg1933): заголовок «Библиотека» как в окнах
         Каталога/Настроек, а справа в том же ряду компактная кнопка ⋮ «Ещё» —
         как в современных приложениях. При возврате из читалки фокус ставится на
         заголовок — TalkBack озвучивает «Библиотека», а не имя приложения.
         msg2274/2278/2280: заголовок фокусируемый с первого кадра и ПЕРВЫЙ в
         окне — скринридер при показе полки паркуется на нём, а не на ⋮ «Ещё»
         (раньше был первым фокусируемым — фокус падал на кнопку). Список не
         касается (L1b). Раньше ⋮ стояла большой кнопкой ниже, в ряду с
         «Продолжить» — поднята в шапку единым рядом с остальными окнами. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:focusable="true"
            android:screenReaderFocusable="true"
            android:accessibilityHeading="true"
            android:maxLines="1"
            android:text="@string/go_library"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/bvInk" />

        <Button
            android:id="@+id/btnMore"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/lib_more"
            android:text="⋮"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Фильтры библиотеки по статусу (msg643): «Читаю / Новые / Дочитано / Все».
         Это вкладки, как нижние (#55/#60): активная — акцентным цветом и полоской
         снизу, роль и озвучку выставляет код. Вкладки строятся в коде
         (LibraryActivity.buildFilterTabs) в контейнер filterBar — стиль и
         contentDescription переиспользуют TabNav.styleTab / tabDesc.
         29.10.2026, просьба Сержа: вкладки ВСЕГДА В ОДНУ СТРОКУ и прокручиваются
         вбок. При крупном системном шрифте подписи переносились на вторую строку,
         и два ряда вкладок съедали пол-экрана полки. Ради этого контейнер завёрнут
         в HorizontalScrollView: подписи больше не переносятся (maxLines=1 в коде),
         а лишние уезжают за правый край и достаются свайпом по строке.

         03.11.2026: `fillViewport` ЗДЕСЬ НЕЛЬЗЯ (было `true` — и это ломало
         вкладки). Он растягивает ряд до ширины экрана, и подпись получает
         ограничение AT_MOST на всю ширину; полоска-индикатор под вкладкой —
         обычный View, а такой View под AT_MOST отдаёт РОВНО предложенный размер.
         В результате ПЕРВАЯ вкладка становилась шириной во весь экран, а все
         остальные уезжали за правый край: Серж видел одну вкладку «Избранное»,
         переключался свайпом на «Все» (озвучка была), а наверху ничего не
         менялось — выбранная вкладка стояла за экраном. Не включать обратно. -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/bvTrack" />

    <!-- 29.10.2026, жалоба Сержа «кнопки съехали вверх»: на пустой вкладке список
         книг прятался (`GONE`), и нижний ряд с «Открыть книгу» и «Сетевые»
         подскакивал под сообщение.

         Второе, найденное в тот же день: на ПУСТОЙ вкладке не работал свайп
         влево-вправо. Причина — список был скрыт, середина экрана оказывалась
         обычным текстом, и жест скринридер забирал себе. Поэтому теперь список
         книг НЕ прячется никогда: он всегда лежит под сообщением (вес 1 держит
         нижний ряд внизу и ловит касания), а сообщение рисуется поверх него. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/books_empty"
            android:textColor="?attr/bvDim"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Нижний ряд быстрых действий (msg2351/2355): слева — вход в последнюю
         книгу, правее — «Каталоги». msg1974: Сергей водит пальцем внизу
         (касание-обзор), ряд всегда на одном месте нижней части экрана,
         независимо от длины списка.
         btnLast (msg646/649, msg1938): умная кнопка — код ставит текст
         «Открыть книгу: <книга>» (msg2108, раньше «Продолжить»), чтобы было
         слышно, куда ведёт; нет доступной последней книги — скрыта совсем
         (visibility ставит код). По умолчанию gone: до первого refresh пустая
         кнопка в a11y-дереве не висит.
         btnCatalogs: быстрый вход в окно «Сетевые библиотеки» поверх полки — ровно
         тот же переход, что пункт «Сетевые библиотеки» в «⋮» полки; видна ВСЕГДА
         (пустая полка —
         логично сразу идти за книгой).
         msg4191/4193/4197: у кнопки два имени — на экране короткое «Сетевые»
         (не «Библиотеки»: рядом открыта своя «Библиотека», путалось бы), а
         синтезатору она называется «Сетевые библиотеки» (contentDescription).
         Так кнопка влезает в нижний ряд и не выдавливает «Открыть книгу». -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <Button
            android:id="@+id/btnLast"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/continue_last"
            android:textSize="17sp"
            android:visibility="gone"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="17sp"
            app:autoSizeStepGranularity="1sp" />

        <Button
            android:id="@+id/btnCatalogs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/catalog_title"
            android:text="@string/catalog_title_short"
            android:textSize="17sp" />
    </LinearLayout>

</LinearLayout>
