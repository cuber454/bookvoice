<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Шапка окна-дома (msg1690 + msg1933): заголовок «Библиотека» как в окнах
         Каталога/Настроек, а справа в том же ряду компактная кнопка ⋮ «Ещё» —
         как в современных приложениях. При возврате из читалки фокус ставится на
         заголовок — TalkBack озвучивает «Библиотека», а не имя приложения. Сам
         по себе заголовок не фокусируемый — цель только для переноса; список не
         касается (L1b). Раньше ⋮ стояла большой кнопкой ниже, в ряду с
         «Продолжить» — поднята в шапку единым рядом с остальными окнами. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/go_library"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="#E8EAED" />

        <Button
            android:id="@+id/btnMore"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/lib_more"
            android:text="⋮"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Фильтры библиотеки по статусу (msg643): «Читаю / Новые / Дочитано / Все».
         Это вкладки, как нижние (#55/#60): активная — акцентным цветом и полоской
         снизу, роль и озвучку выставляет код. Вкладки строятся в коде
         (LibraryActivity.buildFilterTabs) в контейнер filterBar — стиль и
         contentDescription переиспользуют TabNav.styleTab / tabDesc. -->
    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3C4043" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="28dp"
        android:text="@string/books_empty"
        android:textColor="#9AA0A6"
        android:textSize="18sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bookList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

    <!-- Быстрый вход в последнюю книгу (msg646/649), msg1974: перенесена вниз,
         под список, — Сергей пользуется режимом «касание-обзор» и водит пальцем,
         а при удержании телефона палец лежит внизу: кнопка всегда на одном месте
         нижней части экрана, независимо от длины списка. msg1938: кнопка умная —
         код ставит текст «Открыть книгу: <книга>» (msg2108, раньше «Продолжить»),
         чтобы было слышно, куда ведёт; нет доступной последней книги — кнопка
         скрыта совсем (visibility ставит код). По умолчанию gone: до первого
         refresh пустая кнопка в a11y-дереве не висит. -->
    <Button
        android:id="@+id/btnLast"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/continue_last"
        android:textSize="17sp"
        android:visibility="gone"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeMaxTextSize="17sp"
        app:autoSizeStepGranularity="1sp" />

</LinearLayout>
