<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- msg1712: шапка как в FBReader — кнопка «Назад» слева от заголовка.
             В корне («Мои каталоги») — закрывает окно на полку; внутри ленты/на
             странице книги — на уровень выше (то же, что системный «назад»). -->
        <Button
            android:id="@+id/btnBack"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/catalog_back_top"
            android:text="@string/catalog_back_icon"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:focusable="true"
            android:screenReaderFocusable="true"
            android:accessibilityHeading="true"
            android:accessibilityTraversalBefore="@id/btnBack"
            android:maxLines="1"
            android:text="@string/catalog_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="#E8EAED" />

        <Button
            android:id="@+id/btnSearch"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/catalog_search_top"
            android:text="@string/catalog_search_icon"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnMore"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/lib_more"
            android:text="⋮"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- msg2339/2343: содержимое (список/лента/книга) + плавающая кнопка
         «Добавить каталог» в правом нижнем углу. FAB поверх скролла, только в
         корне «Мои каталоги»; в ленте/на странице книги скрывается (renderTop). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAddFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/catalog_add"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:backgroundTint="#8AB4F8"
            app:tint="#101418" />
    </FrameLayout>

    <!-- Нижний ряд быстрых действий на ГЛУБИНЕ каталога (msg2359/2363): когда
         открыта лента/жанр/страница книги, внизу всегда панель как на полке —
         слева умная «Открыть книгу: <последняя>», правее «Библиотека» (одно
         касание до полки, минуя многоуровневый «назад»). В корне «Мои каталоги»
         панель скрыта (там домой уводит «←», а внизу — FAB «Добавить каталог»);
         visibility ряда и кнопок ставит код (updateBottomBar). -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnCatContinue"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/continue_last"
            android:textSize="17sp"
            android:visibility="gone"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="17sp"
            app:autoSizeStepGranularity="1sp" />

        <Button
            android:id="@+id/btnCatLibrary"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:text="@string/go_library"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
