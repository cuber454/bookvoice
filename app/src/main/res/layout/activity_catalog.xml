<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- msg1712: шапка как в FBReader — кнопка «Назад» слева от заголовка.
             В корне («Мои каталоги») — закрывает окно на полку; внутри ленты/на
             странице книги — на уровень выше (то же, что системный «назад»). -->
        <Button
            android:id="@+id/btnBack"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/catalog_back_top"
            android:text="@string/catalog_back_icon"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:focusable="true"
            android:screenReaderFocusable="true"
            android:accessibilityHeading="true"
            android:accessibilityTraversalBefore="@id/btnBack"
            android:maxLines="1"
            android:text="@string/catalog_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="#E8EAED" />

        <Button
            android:id="@+id/btnSearch"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/catalog_search_top"
            android:text="@string/catalog_search_icon"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnMore"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/lib_more"
            android:text="⋮"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Панель поиска по каталогу (msg3214): вместо диалога по центру — строка
         под шапкой, как панель поиска в читалке. Открывается кнопкой 🔍 шапки,
         когда верхняя лента поисковая; поле сразу в фокусе, клавиатура поднимается
         сама (requestFocus + showSoftInput). Поле + голосовой ввод + «Найти». -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:hint="@string/catalog_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#E8EAED"
            android:textColorHint="#9AA0A6"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSearchMic"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/catalog_search_mic"
            android:minWidth="48dp"
            android:text="🎤"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSearchGo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:text="@string/catalog_search_ok"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Содержимое (список/лента/книга). «Добавить каталог» больше не плавает
         в углу (msg2371): вход — пункт ⋮ меню в корне «Мои каталоги». -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp" />
    </ScrollView>

    <!-- Нижний ряд быстрых действий каталога на ВСЕХ уровнях, включая корень
         «Мои каталоги» (msg2371): панель как на полке — слева умная «Открыть
         книгу: <последняя>», правее «Библиотека» (одно касание до полки с любого
         уровня, минуя многоуровневый «назад»). В корне это тот же ряд — больше
         нет ни FAB, ни особого состояния; видимость левой кнопки (нет последней
         книги — скрыта) ставит код (updateBottomBar). -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <Button
            android:id="@+id/btnCatContinue"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/continue_last"
            android:textSize="17sp"
            android:visibility="gone"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="17sp"
            app:autoSizeStepGranularity="1sp" />

        <Button
            android:id="@+id/btnCatLibrary"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:text="@string/go_library"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
