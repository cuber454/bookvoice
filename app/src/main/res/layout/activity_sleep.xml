<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Не засыпать» (msg4705/4709). Тот же каркас, что у окон «О программе»
     и Настроек: шапка «Назад» + заголовок, под ней скролл-контент. Контент
     строится кодом (SleepWindowActivity): состояние запретов, кнопки системных
     экранов и подсказки словами. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/catalog_back_top"
            android:text="@string/catalog_back_icon"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:focusable="true"
            android:screenReaderFocusable="true"
            android:accessibilityHeading="true"
            android:accessibilityTraversalBefore="@id/btnBack"
            android:maxLines="1"
            android:text="@string/sleep_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="#E8EAED" />

        <Button
            android:id="@+id/btnMore"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/lib_more"
            android:text="⋮"
            android:textSize="26sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
