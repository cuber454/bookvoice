<?xml version="1.0" encoding="utf-8"?>
<!-- Абзац книги в ленте читалки (msg6322): обычный книжный текст, а не строка
     списка. Перенос строки — по словам; границы предложений внутри абзаца
     диктору отдаёт ParagraphView виртуальными узлами (красная строка абзаца —
     LeadingMarginSpan, его ставит SentenceAdapter).

     Воздух между абзацами — собственный paddingTop строки: между абзацами он
     даёт отбивку, а внутри абзаца строки идут встык, как в книге.
     focusable=false намеренно: цель диктора — предложения внутри, а не абзац
     целиком (иначе он прочитал бы текст дважды). ExploreByTouchHelper, впрочем,
     всё равно делает представление фокусируемым — так требует его устройство.

     Набор строки — как на веб-странице (msg6340/6342, просьба Сергея): выключка
     по обоим краям (justificationMode, API 26+) и переносы по правилам языка
     (hyphenationFrequency). На старых системах атрибуты просто не применяются. -->
<com.cuber.bookvoice.ParagraphView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvParagraph"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:hyphenationFrequency="normal"
    android:importantForAccessibility="yes"
    android:justificationMode="inter_word"
    android:lineSpacingMultiplier="1.3"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="0dp"
    android:textColor="?attr/bvInk"
    android:textSize="20sp" />
