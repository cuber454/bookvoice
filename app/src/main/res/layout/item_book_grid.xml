<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка книги в режиме «сетка» (msg646/649). Обложек нет — сетка текстом:
     название крупным и автор под ним. Один фокусный узел — вся карточка; текст
     для TalkBack (что именно озвучить) и клики выставляет BookAdapter в коде.
     Видимые TextView помечены как несущественные для доступности, чтобы
     TalkBack не спотыкался о них отдельно от карточки.

     msg6183: потолок строк поднят. Было название 3 строки и автор 1 строка с
     ellipsize=end — при крупном шрифте (Настройки → размер текста) в узкую
     колонку влезало «Николай Юрьеви…» и «Рука на пульсе. Случаи из практики
     мол…», то есть половина названия. Стало 6 и 2.
     Почему не «без потолка вовсе» (msg6187: Сергей спросил, не станут ли
     карточки несоизмеримо большими — станут): у названия-монстра в 150 знаков
     карточка вымахивает в треть экрана. Шесть строк при крупном шрифте — это
     ~80 знаков, с запасом больше любого реального названия; обрезка возможна
     теперь только на совсем диких метаданных. Ущерб от прежней обрезки был
     всё равно только на глаз — диктору уходит contentDescription с полным
     названием. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="92dp"
    android:layout_margin="4dp"
    android:background="@drawable/book_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="6"
        android:textColor="?attr/bvInk"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCardAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textColor="?attr/bvDim"
        android:textSize="14sp" />
</LinearLayout>
