<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка книги в режиме «сетка» (msg646/649). Обложка — украшение
     (23.09.2026, просьба Сергея: «как в FBReader»): картинка помечена как
     неважная для доступности, поэтому диктор по-прежнему видит ОДИН узел —
     всю карточку; текст для TalkBack (название, автор, процент) и клики
     выставляет BookAdapter в коде.

     Автор (tvCardAuthor) на карточке есть, но показывается ТОЛЬКО когда
     обложки не показаны — снята галочка «Показывать обложки книг» или картинку
     взять неоткуда. Тогда карточка снова текстовая, и автор в ней нужнее всего.
     С обложкой автора не показываем: строку отдали названию, у него четыре
     строки вместо трёх, поэтому длинные названия почти не обрезаются. Диктор
     автор слышит всегда — он приходит текстом карточки (cardText), а не из
     разметки; в списке и в окне «О книге» автор тоже виден. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="92dp"
    android:layout_margin="4dp"
    android:background="@drawable/book_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivCardCover"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="4"
        android:textColor="?attr/bvInk"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCardAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="?attr/bvDim"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
