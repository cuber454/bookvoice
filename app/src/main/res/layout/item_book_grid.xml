<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка книги в режиме «сетка» (msg646/649). Обложка — украшение
     (23.09.2026, просьба Сергея: «как в FBReader»): картинка помечена как
     неважная для доступности, поэтому диктор по-прежнему видит ОДИН узел —
     всю карточку; текст для TalkBack (название, автор, процент) и клики
     выставляет BookAdapter в коде.

     Подписи (название и автор) показываются ТОЛЬКО когда обложек нет — снята
     галочка «Показывать обложки книг». С обложкой подписи скрыты: название и
     автор и так написаны на картинке (на настоящей — как нарисовано, на нашей
     заглушке — крупными буквами), и подпись под ней была бы повтором. Карточка
     от этого короче, книг на экран больше.

     tvCardProgress — цифра прочитанного в углу обложки: единственное, чего на
     обложке нет. Видна только у начатых книг, только вместе с обложками и
     только для глаз: диктору процент приходит текстом карточки, поэтому у
     надписи importantForAccessibility="no" и лишнего узла в обходе не будет. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="92dp"
    android:layout_margin="4dp"
    android:background="@drawable/book_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp">

        <ImageView
            android:id="@+id/ivCardCover"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvCardProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/cover_progress_bg"
            android:importantForAccessibility="no"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="4"
        android:textColor="?attr/bvInk"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCardAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="?attr/bvDim"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
