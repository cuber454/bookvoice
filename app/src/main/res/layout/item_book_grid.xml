<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка книги в режиме «сетка» (msg646/649). Обложка — украшение
     (23.09.2026, просьба Сергея: «как в FBReader»): картинка помечена как
     неважная для доступности, поэтому диктор по-прежнему видит ОДИН узел —
     всю карточку; текст для TalkBack (название, автор, процент) и клики
     выставляет BookAdapter в коде.

     23.09.2026, вторая правка: АВТОРА на карточке больше нет (решение Сергея).
     Освободившуюся строку отдали названию — четыре строки вместо трёх, длинные
     названия почти перестают обрезаться. Для диктора и для вида «Список» автор
     остался: он читается в тексте карточки (cardText) и виден в строке списка,
     так что на слух ничего не потеряно. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="92dp"
    android:layout_margin="4dp"
    android:background="@drawable/book_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivCardCover"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="4"
        android:textColor="?attr/bvInk"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
